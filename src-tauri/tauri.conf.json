{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WonderAnalyzer",
  "version": "1.2.0",
  "identifier": "com.freebuff.wonderanalyzer",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WonderAnalyzer",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
